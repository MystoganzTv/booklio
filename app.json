{
  "expo": {
    "name": "Booklio",
    "slug": "booklio",
    "version": "1.0.0",
    "scheme": "booklio",
    "orientation": "portrait",
    "icon": "./assets/brand/booklio-icon.png",
    "favicon": "./assets/brand/booklio-icon.png",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/brand/booklio-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "bundleIdentifier": "com.mystodev.booklio",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Booklio uses the camera to photograph book covers and scan ISBN barcodes.",
        "NSPhotoLibraryUsageDescription": "Booklio uses your photo library to import pictures of physical books."
      }
    },

    "android": {
      "package": "com.mystodev.booklio",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },

    "plugins": [
      "expo-font",
      "expo-camera",
      "expo-image-picker",
      "expo-asset",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-secure-store",

      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.TU_REVERSED_IOS_CLIENT_ID"
        }
      ]
    ],

    "extra": {
      "googleAuth": {
        "webClientId": "167166673441-1m9fio2dlddt0a053ip2o8b6tan85pdb.apps.googleusercontent.com",

        "iosClientId": "TU_IOS_CLIENT_ID.apps.googleusercontent.com",

        "androidClientId": "167166673441-v01ji3rds3frjipugsur98fdvlcm0li9.apps.googleusercontent.com"
      },

      "eas": {
        "projectId": "280cde91-ff6e-4e44-8ceb-53eed6ce39b0"
      }
    }
  }
}
